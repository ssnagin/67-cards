// USER И ЕГО СВЯЗУЮЩИЕ

Project 67Cards {
    database_type: 'PostgreSQL'
    Note: 'Какое-то описание'
}

Table 67Cards.user {
    id long [pk, increment]
    username text [not null]
    email text [not null]
    password_hash text [not null]
    role 67Cards.UserRoles [default: 'user']
    created_at timestamptz [default: `now()`]
    updated_at timestamptz [default: `now()`]

    Note {
        'Test Note'
    }
}

Table 67Cards.auth_sessions {
    id uuid [pk, increment]
    user_id long [pk, increment]

    refresh_token_hash text [not null, unique]

    created_at timestamptz [not null, default: `now()`]
    expires_at timestamptz [not null]
    revoked_at timestamptz
}

Ref auth_sessions_keys {
    67Cards.user.id < 67Cards.auth_sessions.user_id
}

Table 67Cards.collections {
    id long
    user_id text
    text json
    created timestamptz
    modified timestamptz
}

Table 67Cards.game_sessions {
    
}

Enum 67Cards.UserRoles {
    admin
    user
}

Table 67Cards.Session {
    id long [pk, increment]
}

Table 67Cards.Card {
    id long [pk, increment]
}

