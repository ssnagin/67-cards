// 67 Cards. Логическая реляционная модель по требованиям, прочитанным 03.11.2026.
// Источник: https://docs.google.com/document/d/1r_w7RIxAuTG3jx8edpk0dcFL78XL3K0w-D55ILm642U/edit?tab=t.0
// Решения, допущения и правила, требующие транзакций/триггеров: docs/ER2-notes.md.
// Это проект схемы, а не описание уже реализованной базы и не миграция.

Project cards_67 {
  database_type: 'PostgreSQL'
  Note: '''
    Пользователь -> наборы карточек и мероприятия -> неизменяемые версии сценария -> игровые сессии.
    Ведущий является пользователем, игрок является участником сессии и может быть гостем.
    Лобби является состоянием сессии. Лидерборд рассчитывается из журнала баллов.
    JSONB используется только для структурированного текста со списками и таблицами.
    Настройки режимов, ставки, результаты и связи хранятся в отдельных таблицах.
  '''
}

Enum access_level {
  viewer
  editor
}

Enum card_side {
  front
  back
}

Enum version_status {
  draft
  published
}

Enum stage_type {
  quiz
  jeopardy
  prediction_market
  auction
  case_spin
  roulette
}

Enum session_status {
  lobby
  running
  paused
  completed
  cancelled
}

Enum progress_status {
  pending
  running
  completed
  skipped
}

Enum round_status {
  preparing
  accepting
  locked
  resolved
  cancelled
}

Enum question_selection {
  host
  player
  turn_order
  vote
}

Enum bid_step_type {
  linear
  exponential
}

Enum auction_turn_mode {
  free
  turn_order
}

Enum dispute_method {
  host
  coin_toss
  rock_paper_scissors
}

Enum no_bid_action {
  skip
  force_all
}

Enum rank_origin {
  top
  bottom
}

Enum point_basis {
  fixed_points
  player_balance_fraction
  total_balance_fraction
}

Enum effect_type {
  add_points
  multiply_balance
  reward
}

Enum command_status {
  applied
  rejected
}

Enum score_reason {
  initial_balance
  correct_answer
  wrong_answer
  missing_answer
  speed_bonus
  rank_modifier
  leader_reduction
  market_stake
  market_refund
  market_payout
  market_no_winner
  auction_payment
  case_effect
  roulette_stake
  roulette_payout
  manual_adjustment
  reversal
}

// -----------------------------------------------------------------------------
// Учетные записи, авторизация, личное рабочее пространство.
// Рабочее пространство выражено владением материалами: отдельной пустой таблицы нет.
// -----------------------------------------------------------------------------
Table users {
  id bigint [pk, increment]
  username varchar(64) [not null, unique]
  email varchar(254) [not null, unique]
  password_hash varchar(255) [not null, note: 'bcrypt с солью; открытый пароль не сохраняется']
  display_name varchar(100) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Логин и email нормализуются перед записью. Роли ведущего и игрока контекстные, а не глобальный role пользователя. F.1.1-F.1.4.'
}

Table auth_sessions {
  id uuid [pk]
  user_id bigint [not null]
  refresh_token_hash varchar(255) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  revoked_at timestamptz

  indexes {
    user_id
    expires_at
  }
  checks {
    `expires_at > created_at`
  }
  Note: 'Сессия авторизации отличается от игровой. Выход отзывает refresh-токен; политика отзыва access-токенов описана в notes.'
}

Table media_assets {
  id bigint [pk, increment]
  owner_id bigint [not null]
  storage_key text [not null, unique]
  mime_type varchar(100) [not null]
  byte_size bigint [not null, check: `byte_size > 0`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    owner_id
  }
  Note: 'Метаданные изображения; сами файлы находятся в закрытом файловом/объектном хранилище. Доступ выдается через доступ к материалу.'
}

// -----------------------------------------------------------------------------
// Наборы, доступ и история карточек. Документ с карточками = набор карточек.
// -----------------------------------------------------------------------------
Table card_sets {
  id bigint [pk, increment]
  owner_id bigint [not null]
  title varchar(200) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  lock_version bigint [not null, default: 1, check: `lock_version > 0`]

  indexes {
    (owner_id, updated_at)
  }
  Note: 'Лимит карточек задается политикой приложения и проверяется под блокировкой набора. F.2.1-F.2.2.'
}

Table card_set_access {
  card_set_id bigint [not null]
  user_id bigint [not null]
  permission access_level [not null]
  granted_at timestamptz [not null, default: `now()`]

  indexes {
    (card_set_id, user_id) [pk]
    user_id
  }
  Note: 'Доступ viewer/editor на весь набор; владелец имеет полный доступ без отдельной записи. F.2.5-F.2.6.'
}

Table cards {
  id bigint [pk, increment]
  card_set_id bigint [not null]
  position integer [check: `position > 0`]
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (card_set_id, position) [unique]
  }
  checks {
    `(deleted_at IS NULL) = (position IS NOT NULL)`
  }
  Note: 'Мягкое удаление обнуляет позицию и сохраняет историю редактирования; удаление аккаунта/набора физически удаляет карточку и ревизии.'
}

Table card_revisions {
  id bigint [pk, increment]
  card_id bigint [not null]
  revision_no integer [not null, check: `revision_no > 0`]
  editor_id bigint
  front_content jsonb [not null]
  back_content jsonb [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (card_id, revision_no) [unique]
    editor_id
  }
  Note: 'Неизменяемые ревизии обеих сторон. Текущая = наибольший revision_no. JSONB содержит документ редактора, а не сущности/настройки игры. Новая ревизия создается с проверкой ожидаемого номера. F.2.3, F.2.6.'
}

Table card_revision_images {
  revision_id bigint [not null]
  side card_side [not null]
  node_key varchar(100) [not null]
  asset_id bigint [not null]

  indexes {
    (revision_id, side, node_key) [pk]
    asset_id
  }
  Note: 'node_key соответствует узлу изображения в документе стороны; связь с файлом защищена FK. F.2.4.'
}

// -----------------------------------------------------------------------------
// Мероприятие и его версии. После публикации все содержимое версии неизменяемо.
// Изменения создают новую draft-версию; запущенные сессии сохраняют старую.
// -----------------------------------------------------------------------------
Table events {
  id bigint [pk, increment]
  owner_id bigint [not null]
  title varchar(200) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (owner_id, updated_at)
  }
}

Table event_versions {
  id bigint [pk, increment]
  event_id bigint [not null]
  version_no integer [not null, check: `version_no > 0`]
  status version_status [not null, default: 'draft']
  title varchar(200) [not null, note: 'Название на момент создания версии']
  description text
  initial_points numeric(18,2) [not null, default: 0, check: `initial_points >= 0`]
  hide_future_stages boolean [not null, default: true]
  require_game_before_market boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  published_at timestamptz

  indexes {
    (event_id, version_no) [unique]
  }
  checks {
    `(status = 'published') = (published_at IS NOT NULL)`
  }
  Note: 'Публикация проверяет целостность всего сценария и порядок этапов. Сессии используют только опубликованные версии. F.3.1-F.3.9.'
}

Table stages {
  id bigint [pk, increment]
  event_version_id bigint [not null]
  type stage_type [not null]
  title varchar(200) [not null]
  position integer [not null, check: `position > 0`]

  indexes {
    (event_version_id, position) [unique]
    (id, event_version_id) [unique]
  }
  Note: 'Общие поля этапа. Ровно одна таблица настроек должна соответствовать type; это проверяется при публикации. F.3.8.'
}

Table stage_setting_visibility {
  stage_id bigint [not null]
  setting_key varchar(100) [not null]
  visible_to_players boolean [not null, default: false]

  indexes {
    (stage_id, setting_key) [pk]
  }
  Note: 'Только видимость конкретного параметра из разрешенного каталога; значения параметров здесь не хранятся. Не переопределяет сокрытие будущих этапов и правильных ответов.'
}

Table rank_modifiers {
  event_version_id bigint [not null]
  origin rank_origin [not null]
  rank_offset integer [not null, check: `rank_offset > 0`]
  correct_answer_multiplier numeric(8,4) [not null, check: `correct_answer_multiplier >= 0`]

  indexes {
    (event_version_id, origin, rank_offset) [pk]
  }
  Note: 'Позиция от начала/конца рейтинга: top/1/0.85 = -15%, bottom/1/1.50 = +50%. Не ограничено тремя местами. F.3.5-F.3.6.'
}

Table leader_reduction_rules {
  event_version_id bigint [pk]
  enabled boolean [not null, default: true]
  lead_ratio numeric(12,4) [not null, check: `lead_ratio > 1`]
  die_sides integer [not null, default: 6, check: `die_sides > 0`]
  winning_faces integer [not null, default: 1, check: `winning_faces > 0`]
  remaining_fraction numeric(8,6) [not null, default: 0.5]

  checks {
    `winning_faces <= die_sides`
    `remaining_fraction >= 0 AND remaining_fraction <= 1`
  }
  Note: 'Допущение: отрыв = баланс единственного лидера / положительный баланс второго места. winning_faces/die_sides задает шанс. F.3.7.'
}

// -----------------------------------------------------------------------------
// Шесть типов настроек. Никакой общей таблицы с десятками nullable-параметров.
// -----------------------------------------------------------------------------
Table quiz_settings {
  stage_id bigint [pk]
  base_points numeric(18,2) [not null, check: `base_points >= 0`]
  answer_seconds integer [not null, check: `answer_seconds > 0`]
  speed_bonus_max numeric(18,2) [not null, default: 0, check: `speed_bonus_max >= 0`]
  wrong_answer_penalty numeric(18,2) [not null, default: 0, check: `wrong_answer_penalty >= 0`]
  missing_answer_penalty numeric(18,2) [not null, default: 0, check: `missing_answer_penalty >= 0`]
  default_answer text

  Note: 'Готовые варианты или свободный ответ задаются отдельно у каждого вопроса. F.4.1.'
}

Table jeopardy_settings {
  stage_id bigint [pk]
  selection_mode question_selection [not null, default: 'host']
  vote_seconds integer [check: `vote_seconds > 0`]
  answer_seconds integer [check: `answer_seconds > 0`]
  open_answer_multiplier numeric(8,4) [not null, default: 1, check: `open_answer_multiplier >= 0`]
  wrong_answer_penalty numeric(18,2) [not null, default: 0, check: `wrong_answer_penalty >= 0`]

  Note: 'NULL времени означает отсутствие таймера. Ведущий оценивает ответ победителя очереди готовности. F.4.2-F.4.3.'
}

Table market_settings {
  stage_id bigint [pk]
  betting_seconds integer [not null, check: `betting_seconds > 0`]
  minimum_basis point_basis [not null, default: 'fixed_points']
  minimum_value numeric(18,6) [not null, check: `minimum_value > 0`]
  maximum_points numeric(18,2) [check: `maximum_points > 0`]
  allow_bet_changes boolean [not null, default: false]
  show_pool boolean [not null, default: false]
  show_distribution boolean [not null, default: false]
  show_bettors boolean [not null, default: false]
  no_winner_delta numeric(18,2) [not null, default: 0, note: '0 = ничего; положительное = всем бонус; отрицательное = всем штраф']

  checks {
    `minimum_basis <> 'total_balance_fraction'`
    `minimum_basis = 'fixed_points' OR minimum_value <= 1`
    `minimum_basis <> 'fixed_points' OR maximum_points IS NULL OR maximum_points >= minimum_value`
  }
  Note: 'Выплата по F.4.8: общий банк * ставка игрока на верный исход / сумма ставок на верный исход. Независимые фиксированные коэффициенты не используются. F.4.7-F.4.10.'
}

Table auction_settings {
  stage_id bigint [pk]
  minimum_step numeric(18,2) [not null, check: `minimum_step > 0`]
  step_type bid_step_type [not null, default: 'linear']
  step_growth_factor numeric(8,4) [not null, default: 2, check: `step_growth_factor > 1`]
  turn_mode auction_turn_mode [not null, default: 'free']
  dispute_resolution dispute_method [not null, default: 'host']
  on_no_bids no_bid_action [not null, default: 'skip']
  bidding_seconds integer [check: `bidding_seconds > 0`]
  extend_after_bid_seconds integer [not null, default: 0, check: `extend_after_bid_seconds >= 0`]

  Note: 'NULL bidding_seconds = закрытие ведущим. Экспоненциальный шаг = minimum_step * factor^число ранее принятых повышений. F.4.4-F.4.6, F.5.6.'
}

Table case_settings {
  stage_id bigint [pk]
  automatic_spin boolean [not null, default: true]

  Note: 'Индивидуальное масштабирование баллов определяется эффектом сектора с базисом player_balance_fraction. F.4.11-F.4.12.'
}

Table roulette_settings {
  stage_id bigint [pk]
  betting_seconds integer [not null, check: `betting_seconds > 0`]
  minimum_points numeric(18,2) [not null, check: `minimum_points > 0`]
  maximum_points numeric(18,2) [not null]

  checks {
    `maximum_points >= minimum_points`
  }
  Note: 'Выигрышные наборы секторов и коэффициенты задаются отдельными вариантами ставок. F.4.13-F.4.14.'
}

// -----------------------------------------------------------------------------
// Контент этапов: вопросы, исходы прогнозов, лоты, секторы и эффекты.
// -----------------------------------------------------------------------------
Table question_categories {
  id bigint [pk, increment]
  stage_id bigint [not null]
  title varchar(200) [not null]
  position integer [not null, check: `position > 0`]

  indexes {
    (stage_id, position) [unique]
    (id, stage_id) [unique]
  }
}

Table questions {
  id bigint [pk, increment]
  stage_id bigint [not null]
  category_id bigint
  source_card_revision_id bigint
  position integer [not null, check: `position > 0`]
  prompt_content jsonb [not null]
  answer_content jsonb [not null]
  has_answer_choices boolean [not null, default: false]
  points numeric(18,2) [check: `points >= 0`]

  indexes {
    (stage_id, position) [unique]
    (id, stage_id) [unique]
    source_card_revision_id
  }
  Note: 'Самостоятельная копия карточки при импорте. Удаление/редактирование источника не меняет вопрос. points обязателен для Своей игры, NULL у викторины = base_points. F.3.3-F.3.4.'
}

Table answer_choices {
  id bigint [pk, increment]
  question_id bigint [not null]
  position integer [not null, check: `position > 0`]
  content jsonb [not null]
  is_correct boolean [not null, default: false]

  indexes {
    (question_id, position) [unique]
    (id, question_id) [unique]
  }
  Note: 'Допущение: один правильный вариант. Публикация проверяет его единственность и наличие неверного варианта. NF.2.3: is_correct и answer_content не передаются игрокам до раскрытия.'
}

Table question_images {
  question_id bigint [not null]
  side card_side [not null]
  node_key varchar(100) [not null]
  asset_id bigint [not null]

  indexes {
    (question_id, side, node_key) [pk]
    asset_id
  }
  Note: 'При импорте изображение копируется во владение автора мероприятия, если оно принадлежит другому пользователю. front = вопрос, back = ответ.'
}

Table market_prompts {
  id bigint [pk, increment]
  stage_id bigint [not null]
  position integer [not null, check: `position > 0`]
  description text [not null]

  indexes {
    (stage_id, position) [unique]
    (id, stage_id) [unique]
  }
}

Table market_outcomes {
  id bigint [pk, increment]
  prompt_id bigint [not null]
  position integer [not null, check: `position > 0`]
  title varchar(200) [not null]

  indexes {
    (prompt_id, position) [unique]
    (id, prompt_id) [unique]
  }
  Note: 'Исходы шаблона; наступивший исход хранится у конкретного раунда. Текущие требования предполагают два исхода; количество проверяется при публикации.'
}

Table game_effects {
  id bigint [pk, increment]
  stage_id bigint [not null]
  type effect_type [not null]
  title varchar(200) [not null]
  basis point_basis
  value numeric(18,6)
  reward_description text

  indexes {
    (id, stage_id) [unique]
  }
  checks {
    `(type = 'reward' AND reward_description IS NOT NULL AND basis IS NULL AND value IS NULL) OR (type = 'add_points' AND basis IS NOT NULL AND value IS NOT NULL AND reward_description IS NULL) OR (type = 'multiply_balance' AND basis IS NULL AND value IS NOT NULL AND value >= 0 AND reward_description IS NULL)`
  }
  Note: 'Переиспользуемый эффект лота/сектора: прибавить баллы, умножить баланс или выдать описанную награду. Неопределенные в ТЗ изменения состояния требуют собственных типов/таблиц при уточнении правил.'
}

Table auction_lots {
  id bigint [pk, increment]
  stage_id bigint [not null]
  position integer [not null, check: `position > 0`]
  title varchar(200) [not null]
  description text
  image_asset_id bigint
  starting_price_basis point_basis [not null, default: 'fixed_points']
  starting_price_value numeric(18,6) [not null, check: `starting_price_value > 0`]
  effect_id bigint [not null]

  indexes {
    (stage_id, position) [unique]
    (id, stage_id) [unique]
    image_asset_id
  }
  checks {
    `starting_price_basis <> 'player_balance_fraction'`
    `starting_price_basis = 'fixed_points' OR starting_price_value <= 1`
  }
}

Table case_sectors {
  id bigint [pk, increment]
  stage_id bigint [not null]
  position integer [not null, check: `position > 0`]
  title varchar(200) [not null]
  weight numeric(18,6) [not null, check: `weight > 0`]
  effect_id bigint [not null]

  indexes {
    (stage_id, position) [unique]
    (id, stage_id) [unique]
  }
  Note: 'Вероятность = weight / сумму весов секторов данного этапа.'
}

Table roulette_sectors {
  id bigint [pk, increment]
  stage_id bigint [not null]
  number integer [not null, check: `number >= 0`]
  color varchar(32) [not null]
  weight numeric(18,6) [not null, default: 1, check: `weight > 0`]

  indexes {
    (stage_id, number) [unique]
    (id, stage_id) [unique]
  }
  Note: 'По умолчанию создаются 37 секторов 0-36; модель допускает пользовательские наборы.'
}

Table roulette_bet_options {
  id bigint [pk, increment]
  stage_id bigint [not null]
  title varchar(200) [not null]
  payout_multiplier numeric(12,6) [not null, check: `payout_multiplier > 0`]

  indexes {
    (id, stage_id) [unique]
  }
  Note: 'Конкретная ставка: число 7, красное, четное и т.д. Коэффициент включает возврат ставки; выигрышные секторы задает таблица связи.'
}

Table roulette_option_sectors {
  option_id bigint [not null]
  sector_id bigint [not null]
  stage_id bigint [not null]

  indexes {
    (option_id, sector_id) [pk]
    (sector_id, stage_id)
  }
}

// -----------------------------------------------------------------------------
// Сессии и участники. Составные FK защищают от смешивания разных сессий/этапов.
// -----------------------------------------------------------------------------
Table game_sessions {
  id bigint [pk, increment]
  event_version_id bigint [not null]
  host_user_id bigint [not null]
  join_code varchar(12) [not null, unique]
  status session_status [not null, default: 'lobby']
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz
  paused_at timestamptz
  finished_at timestamptz
  state_version bigint [not null, default: 0, check: `state_version >= 0`]

  indexes {
    (id, event_version_id) [unique]
    (host_user_id, created_at)
    (event_version_id, created_at)
  }
  Note: 'QR-код строится из ссылки с join_code и не хранится. По допущению ведущий является владельцем мероприятия. Пауза сохраняет остаток времени в раунде. F.5.1-F.5.3.'
}

Table session_players {
  id bigint [pk, increment]
  session_id bigint [not null]
  user_id bigint
  nickname varchar(64) [not null]
  reconnect_token_hash varchar(255) [not null, unique]
  joined_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz
  left_at timestamptz

  indexes {
    (id, session_id) [unique]
    (session_id, nickname) [unique]
    (session_id, user_id) [unique]
    user_id
  }
  Note: 'NULL user_id = гость; идентичность при переподключении определяется секретным токеном, а не именем. Токен хранится только как хеш. F.5.2, F.5.9.'
}

Table session_stages {
  session_id bigint [not null]
  stage_id bigint [not null]
  event_version_id bigint [not null]
  status progress_status [not null, default: 'pending']
  started_at timestamptz
  finished_at timestamptz

  indexes {
    (session_id, stage_id) [pk]
    (stage_id, event_version_id)
  }
  Note: 'Состояние исполнения отделено от неизменяемых настроек. Не более одного running-этапа в сессии: частичный уникальный индекс в будущей миграции.'
}

Table game_rounds {
  id bigint [pk, increment]
  session_id bigint [not null]
  stage_id bigint [not null]
  round_no integer [not null, check: `round_no > 0`]
  status round_status [not null, default: 'preparing']
  opened_at timestamptz
  deadline_at timestamptz
  locked_at timestamptz
  resolved_at timestamptz
  remaining_ms_on_pause bigint [check: `remaining_ms_on_pause >= 0`]

  indexes {
    (id, session_id) [unique]
    (id, stage_id) [unique]
    (session_id, stage_id, round_no) [unique]
  }
  Note: 'Ровно один соответствующий типу этапа подтип раунда. Не более одного незавершенного раунда в сессии. Временные метки и дедлайн определяет сервер. F.5.3, F.5.8.'
}

Table game_commands {
  session_id bigint [not null]
  id uuid [not null]
  player_id bigint
  host_user_id bigint
  command_type varchar(64) [not null]
  payload_hash varchar(64) [not null]
  status command_status [not null]
  rejection_code varchar(100)
  received_at timestamptz [not null, default: `now()`]
  resulting_state_version bigint [not null, check: `resulting_state_version >= 0`]

  indexes {
    (session_id, id) [pk]
    (player_id, session_id)
    host_user_id
  }
  checks {
    `(player_id IS NOT NULL) <> (host_user_id IS NOT NULL)`
    `(status = 'rejected') = (rejection_code IS NOT NULL)`
  }
  Note: 'UUID повторной доставки остается тем же. Один UUID с другим payload_hash отклоняется. Команда и все ее эффекты фиксируются одной транзакцией. Серверные таймеры дедуплицируются operation_key в score_operations. NF.3.4.'
}

// -----------------------------------------------------------------------------
// Исполнение вопросов: выбор, голосование, серверная очередь готовности, ответы.
// -----------------------------------------------------------------------------
Table question_rounds {
  round_id bigint [pk]
  stage_id bigint [not null]
  question_id bigint [not null]
  selected_by_player_id bigint
  revealed_at timestamptz

  indexes {
    (round_id, question_id) [unique]
    (question_id, stage_id)
  }
  Note: 'В preparing question_id является выбранным кандидатом; голосование может изменить его до открытия. Игрок выбирающий вопрос должен принадлежать сессии раунда. Один вопрос разыгрывается один раз в сессии.'
}

Table question_votes {
  round_id bigint [not null]
  player_id bigint [not null]
  session_id bigint [not null]
  question_id bigint [not null]
  command_id uuid [not null]

  indexes {
    (round_id, player_id) [pk]
    (session_id, command_id) [unique]
    (player_id, session_id)
    question_id
  }
  Note: 'Один голос в цикле выбора; вопрос должен быть несыгранным и относиться к этапу данного раунда. Голосование закрывается до статуса accepting.'
}

Table buzzer_presses {
  id bigint [pk, increment]
  round_id bigint [not null]
  player_id bigint [not null]
  session_id bigint [not null]
  command_id uuid [not null]
  server_order bigint [not null, check: `server_order > 0`]
  received_at timestamptz [not null]

  indexes {
    (round_id, player_id) [unique]
    (round_id, server_order) [unique]
    (session_id, command_id) [unique]
    (player_id, session_id)
  }
  Note: 'Порядок устанавливает сервер, не клиентские часы. При неверном ответе право ответа получает следующий игрок. F.4.2-F.4.3, NF.1.1.'
}

Table player_answers {
  id bigint [pk, increment]
  round_id bigint [not null]
  question_id bigint [not null]
  player_id bigint [not null]
  session_id bigint [not null]
  command_id uuid [not null]
  choice_id bigint
  free_text text
  submitted_at timestamptz [not null]
  response_ms bigint [not null, check: `response_ms >= 0`]
  is_correct boolean
  evaluated_by_user_id bigint
  evaluated_at timestamptz

  indexes {
    (round_id, player_id) [unique]
    (session_id, command_id) [unique]
    (player_id, session_id)
    (choice_id, question_id)
    evaluated_by_user_id
  }
  checks {
    `(choice_id IS NOT NULL) <> (free_text IS NOT NULL)`
    `(is_correct IS NOT NULL) = (evaluated_at IS NOT NULL)`
  }
  Note: 'Ответ неизменяем после приема; поля оценки заполняются сервером/ведущим отдельно. Отсутствие ответа выражено отсутствием строки и учитывается при расчете раунда.'
}

// -----------------------------------------------------------------------------
// Исполнение рынка и аукциона. Разные виды ставок имеют собственные таблицы.
// -----------------------------------------------------------------------------
Table market_rounds {
  round_id bigint [pk]
  stage_id bigint [not null]
  prompt_id bigint [not null]
  winning_outcome_id bigint

  indexes {
    (round_id, prompt_id) [unique]
    (prompt_id, stage_id)
    (winning_outcome_id, prompt_id)
  }
  Note: 'Фактический исход выбирает ведущий после блокировки ставок.'
}

Table market_bets {
  id bigint [pk, increment]
  round_id bigint [not null]
  prompt_id bigint [not null]
  outcome_id bigint [not null]
  player_id bigint [not null]
  session_id bigint [not null]
  amount numeric(18,2) [not null, check: `amount > 0`]
  last_command_id uuid [not null]
  revision_no integer [not null, default: 1, check: `revision_no > 0`]
  updated_at timestamptz [not null]
  locked_at timestamptz

  indexes {
    (round_id, player_id, outcome_id) [unique]
    (outcome_id, prompt_id)
    (player_id, session_id)
    (session_id, last_command_id)
  }
  Note: 'Допущение: игрок может распределить баллы между исходами. Изменение до закрытия допустимо только при allow_bet_changes, разница списывается/возвращается транзакционно. Журнал баллов сохраняет историю сумм.'
}

Table auction_rounds {
  round_id bigint [pk]
  stage_id bigint [not null]
  lot_id bigint [not null]
  resolved_starting_price numeric(18,2) [not null, check: `resolved_starting_price > 0`]
  winning_bid_id bigint
  resolution_method dispute_method
  resolution_details text

  indexes {
    (lot_id, stage_id)
    (winning_bid_id, round_id) [unique]
  }
  Note: 'Цена в процентах преобразуется в баллы при открытии лота. Решение спора и выбранный победитель фиксируются ведущим; детали броска/жестов сохраняются в resolution_details.'
}

Table auction_bids {
  id bigint [pk, increment]
  round_id bigint [not null]
  player_id bigint [not null]
  session_id bigint [not null]
  command_id uuid [not null]
  amount numeric(18,2) [not null, check: `amount > 0`]
  server_order bigint [not null, check: `server_order > 0`]
  placed_at timestamptz [not null]

  indexes {
    (id, round_id) [unique]
    (round_id, server_order) [unique]
    (session_id, command_id) [unique]
    (player_id, session_id)
  }
  Note: 'Каждое повышение отдельной неизменяемой строкой. Прием сериализуется на раунде и балансе; списание один раз при выборе победителя. Принудительные ставки требуют подтвержденного правила из notes.'
}

// -----------------------------------------------------------------------------
// Случайные механики: сохраняется уже определенный сервером исход.
// -----------------------------------------------------------------------------
Table case_rounds {
  round_id bigint [pk]
  stage_id bigint [not null]
}

Table case_draws {
  round_id bigint [not null]
  player_id bigint [not null]
  session_id bigint [not null]
  stage_id bigint [not null]
  sector_id bigint [not null]
  drawn_at timestamptz [not null]

  indexes {
    (round_id, player_id) [pk]
    (player_id, session_id)
    (sector_id, stage_id)
  }
  Note: 'По одному независимому исходу каждому игроку. Повторное подключение воспроизводит сохраненный исход и не запускает новый розыгрыш. F.4.12.'
}

Table roulette_rounds {
  round_id bigint [pk]
  stage_id bigint [not null]
  winning_sector_id bigint
  drawn_at timestamptz

  indexes {
    (winning_sector_id, stage_id)
  }
  checks {
    `(winning_sector_id IS NOT NULL) = (drawn_at IS NOT NULL)`
  }
}

Table roulette_bets {
  id bigint [pk, increment]
  round_id bigint [not null]
  stage_id bigint [not null]
  option_id bigint [not null]
  player_id bigint [not null]
  session_id bigint [not null]
  command_id uuid [not null]
  amount numeric(18,2) [not null, check: `amount > 0`]
  placed_at timestamptz [not null]

  indexes {
    (session_id, command_id) [unique]
    (round_id, player_id)
    (player_id, session_id)
    (option_id, stage_id)
  }
  Note: 'Несколько ставок на разные варианты разрешены; каждая принятая ставка неизменяема и сразу списывается. Выплата включает возврат выигравшей ставки.'
}

Table leader_reduction_draws {
  round_id bigint [not null]
  player_id bigint [not null]
  session_id bigint [not null]
  rolled_face integer [not null, check: `rolled_face > 0`]
  triggered boolean [not null]
  drawn_at timestamptz [not null]

  indexes {
    (round_id, player_id) [pk]
    (player_id, session_id)
  }
  Note: 'Только для подходящего лидера после раунда. Настройки берутся из версии мероприятия; rolled_face <= winning_faces означает срабатывание. Сохраняется для анимации и аудита. F.5.5.'
}

// -----------------------------------------------------------------------------
// Баллы: неизменяемый журнал и защита от повторного расчета.
// Баланс = SUM(score_entries.delta); лидерборд = ранжирование балансов.
// -----------------------------------------------------------------------------
Table score_operations {
  id bigint [pk, increment]
  session_id bigint [not null]
  round_id bigint
  command_id uuid
  operation_key varchar(200) [not null]
  reason score_reason [not null]
  actor_user_id bigint
  reverses_operation_id bigint
  comment text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (id, session_id) [unique]
    (session_id, operation_key) [unique]
    (round_id, session_id)
    (session_id, command_id)
    (reverses_operation_id, session_id) [unique]
    actor_user_id
  }
  checks {
    `(reason = 'reversal') = (reverses_operation_id IS NOT NULL)`
    `reverses_operation_id IS NULL OR reverses_operation_id <> id`
  }
  Note: 'Детерминированный operation_key описывает бизнес-эффект, например round:42:market_settlement. Предотвращает повторный расчет даже при новом UUID команды. Исправление делается обратной операцией. F.5.7, NF.3.4.'
}

Table score_entries {
  operation_id bigint [not null]
  player_id bigint [not null]
  session_id bigint [not null]
  delta numeric(18,2) [not null]

  indexes {
    (operation_id, player_id) [pk]
    (player_id, session_id)
  }
  Note: 'Одна строка на игрока в операции; положительное = начисление, отрицательное = списание. Все строки операции и изменение состояния раунда фиксируются одной транзакцией.'
}

Table player_rewards {
  id bigint [pk, increment]
  player_id bigint [not null]
  session_id bigint [not null]
  round_id bigint [not null]
  effect_id bigint [not null]
  granted_at timestamptz [not null, default: `now()`]

  indexes {
    (round_id, player_id, effect_id) [unique]
    (player_id, session_id)
    effect_id
  }
  Note: 'Выданные награды типа reward. Числовые эффекты записываются в журнал баллов. Допустимость эффекта для лота/сектора проверяет сервер.'
}

// -----------------------------------------------------------------------------
// Связи и правила удаления. Зависимые данные принадлежат корневому материалу.
// Ссылки на внешний источник карточки и удаленного редактора обнуляются.
// -----------------------------------------------------------------------------
Ref: auth_sessions.user_id > users.id [delete: cascade]
Ref: media_assets.owner_id > users.id [delete: cascade]
Ref: card_sets.owner_id > users.id [delete: cascade]
Ref: card_set_access.card_set_id > card_sets.id [delete: cascade]
Ref: card_set_access.user_id > users.id [delete: cascade]
Ref: cards.card_set_id > card_sets.id [delete: cascade]
Ref: card_revisions.card_id > cards.id [delete: cascade]
Ref: card_revisions.editor_id > users.id [delete: set null]
Ref: card_revision_images.revision_id > card_revisions.id [delete: cascade]
Ref: card_revision_images.asset_id > media_assets.id [delete: restrict]
Ref: events.owner_id > users.id [delete: cascade]
Ref: event_versions.event_id > events.id [delete: cascade]
Ref: stages.event_version_id > event_versions.id [delete: cascade]
Ref: stage_setting_visibility.stage_id > stages.id [delete: cascade]
Ref: rank_modifiers.event_version_id > event_versions.id [delete: cascade]
Ref: event_versions.id - leader_reduction_rules.event_version_id [delete: cascade]
Ref: stages.id - quiz_settings.stage_id [delete: cascade]
Ref: stages.id - jeopardy_settings.stage_id [delete: cascade]
Ref: stages.id - market_settings.stage_id [delete: cascade]
Ref: stages.id - auction_settings.stage_id [delete: cascade]
Ref: stages.id - case_settings.stage_id [delete: cascade]
Ref: stages.id - roulette_settings.stage_id [delete: cascade]
Ref: question_categories.stage_id > stages.id [delete: cascade]
Ref: questions.stage_id > stages.id [delete: cascade]
Ref: questions.(category_id, stage_id) > question_categories.(id, stage_id) [delete: no action]
Ref: questions.source_card_revision_id > card_revisions.id [delete: set null]
Ref: answer_choices.question_id > questions.id [delete: cascade]
Ref: question_images.question_id > questions.id [delete: cascade]
Ref: question_images.asset_id > media_assets.id [delete: restrict]
Ref: market_prompts.stage_id > stages.id [delete: cascade]
Ref: market_outcomes.prompt_id > market_prompts.id [delete: cascade]
Ref: game_effects.stage_id > stages.id [delete: cascade]
Ref: auction_lots.stage_id > stages.id [delete: cascade]
Ref: auction_lots.image_asset_id > media_assets.id [delete: restrict]
Ref: auction_lots.(effect_id, stage_id) > game_effects.(id, stage_id) [delete: no action]
Ref: case_sectors.stage_id > stages.id [delete: cascade]
Ref: case_sectors.(effect_id, stage_id) > game_effects.(id, stage_id) [delete: no action]
Ref: roulette_sectors.stage_id > stages.id [delete: cascade]
Ref: roulette_bet_options.stage_id > stages.id [delete: cascade]
Ref: roulette_option_sectors.(option_id, stage_id) > roulette_bet_options.(id, stage_id) [delete: cascade]
Ref: roulette_option_sectors.(sector_id, stage_id) > roulette_sectors.(id, stage_id) [delete: cascade]
Ref: game_sessions.event_version_id > event_versions.id [delete: cascade]
Ref: game_sessions.host_user_id > users.id [delete: cascade]
Ref: session_players.session_id > game_sessions.id [delete: cascade]
Ref: session_players.user_id > users.id [delete: set null]
Ref: session_stages.(session_id, event_version_id) > game_sessions.(id, event_version_id) [delete: cascade]
Ref: session_stages.(stage_id, event_version_id) > stages.(id, event_version_id) [delete: cascade]
Ref: game_rounds.(session_id, stage_id) > session_stages.(session_id, stage_id) [delete: cascade]
Ref: game_commands.session_id > game_sessions.id [delete: cascade]
Ref: game_commands.(player_id, session_id) > session_players.(id, session_id) [delete: no action]
Ref: game_commands.host_user_id > users.id [delete: no action]
Ref: game_rounds.(id, stage_id) - question_rounds.(round_id, stage_id) [delete: cascade]
Ref: question_rounds.(question_id, stage_id) > questions.(id, stage_id) [delete: no action]
Ref: question_rounds.selected_by_player_id > session_players.id [delete: no action]
Ref: question_votes.round_id > question_rounds.round_id [delete: cascade]
Ref: question_votes.(round_id, session_id) > game_rounds.(id, session_id) [delete: cascade]
Ref: question_votes.(player_id, session_id) > session_players.(id, session_id) [delete: no action]
Ref: question_votes.question_id > questions.id [delete: no action]
Ref: question_votes.(session_id, command_id) > game_commands.(session_id, id) [delete: no action]
Ref: buzzer_presses.round_id > question_rounds.round_id [delete: cascade]
Ref: buzzer_presses.(round_id, session_id) > game_rounds.(id, session_id) [delete: cascade]
Ref: buzzer_presses.(player_id, session_id) > session_players.(id, session_id) [delete: no action]
Ref: buzzer_presses.(session_id, command_id) > game_commands.(session_id, id) [delete: no action]
Ref: player_answers.(round_id, question_id) > question_rounds.(round_id, question_id) [delete: cascade]
Ref: player_answers.(round_id, session_id) > game_rounds.(id, session_id) [delete: cascade]
Ref: player_answers.(player_id, session_id) > session_players.(id, session_id) [delete: no action]
Ref: player_answers.(choice_id, question_id) > answer_choices.(id, question_id) [delete: no action]
Ref: player_answers.(session_id, command_id) > game_commands.(session_id, id) [delete: no action]
Ref: player_answers.evaluated_by_user_id > users.id [delete: set null]
Ref: game_rounds.(id, stage_id) - market_rounds.(round_id, stage_id) [delete: cascade]
Ref: market_rounds.(prompt_id, stage_id) > market_prompts.(id, stage_id) [delete: no action]
Ref: market_rounds.(winning_outcome_id, prompt_id) > market_outcomes.(id, prompt_id) [delete: no action]
Ref: market_bets.(round_id, prompt_id) > market_rounds.(round_id, prompt_id) [delete: cascade]
Ref: market_bets.(round_id, session_id) > game_rounds.(id, session_id) [delete: cascade]
Ref: market_bets.(outcome_id, prompt_id) > market_outcomes.(id, prompt_id) [delete: no action]
Ref: market_bets.(player_id, session_id) > session_players.(id, session_id) [delete: no action]
Ref: market_bets.(session_id, last_command_id) > game_commands.(session_id, id) [delete: no action]
Ref: game_rounds.(id, stage_id) - auction_rounds.(round_id, stage_id) [delete: cascade]
Ref: auction_rounds.(lot_id, stage_id) > auction_lots.(id, stage_id) [delete: no action]
Ref: auction_rounds.(winning_bid_id, round_id) > auction_bids.(id, round_id) [delete: no action]
Ref: auction_bids.round_id > auction_rounds.round_id [delete: cascade]
Ref: auction_bids.(round_id, session_id) > game_rounds.(id, session_id) [delete: cascade]
Ref: auction_bids.(player_id, session_id) > session_players.(id, session_id) [delete: no action]
Ref: auction_bids.(session_id, command_id) > game_commands.(session_id, id) [delete: no action]
Ref: game_rounds.(id, stage_id) - case_rounds.(round_id, stage_id) [delete: cascade]
Ref: case_draws.round_id > case_rounds.round_id [delete: cascade]
Ref: case_draws.(round_id, stage_id) > game_rounds.(id, stage_id) [delete: cascade]
Ref: case_draws.(round_id, session_id) > game_rounds.(id, session_id) [delete: cascade]
Ref: case_draws.(player_id, session_id) > session_players.(id, session_id) [delete: no action]
Ref: case_draws.(sector_id, stage_id) > case_sectors.(id, stage_id) [delete: no action]
Ref: game_rounds.(id, stage_id) - roulette_rounds.(round_id, stage_id) [delete: cascade]
Ref: roulette_rounds.(winning_sector_id, stage_id) > roulette_sectors.(id, stage_id) [delete: no action]
Ref: roulette_bets.round_id > roulette_rounds.round_id [delete: cascade]
Ref: roulette_bets.(round_id, stage_id) > game_rounds.(id, stage_id) [delete: cascade]
Ref: roulette_bets.(round_id, session_id) > game_rounds.(id, session_id) [delete: cascade]
Ref: roulette_bets.(player_id, session_id) > session_players.(id, session_id) [delete: no action]
Ref: roulette_bets.(option_id, stage_id) > roulette_bet_options.(id, stage_id) [delete: no action]
Ref: roulette_bets.(session_id, command_id) > game_commands.(session_id, id) [delete: no action]
Ref: leader_reduction_draws.(round_id, session_id) > game_rounds.(id, session_id) [delete: cascade]
Ref: leader_reduction_draws.(player_id, session_id) > session_players.(id, session_id) [delete: no action]
Ref: score_operations.session_id > game_sessions.id [delete: cascade]
Ref: score_operations.(round_id, session_id) > game_rounds.(id, session_id) [delete: no action]
Ref: score_operations.(session_id, command_id) > game_commands.(session_id, id) [delete: no action]
Ref: score_operations.actor_user_id > users.id [delete: set null]
Ref: score_operations.(reverses_operation_id, session_id) > score_operations.(id, session_id) [delete: no action]
Ref: score_entries.(operation_id, session_id) > score_operations.(id, session_id) [delete: cascade]
Ref: score_entries.(player_id, session_id) > session_players.(id, session_id) [delete: no action]
Ref: player_rewards.(round_id, session_id) > game_rounds.(id, session_id) [delete: cascade]
Ref: player_rewards.(player_id, session_id) > session_players.(id, session_id) [delete: no action]
Ref: player_rewards.effect_id > game_effects.id [delete: no action]

TableGroup accounts {
  users
  auth_sessions
