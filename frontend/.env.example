# mock — локальные демонстрационные данные, real — настоящий Spring Boot API.
NUXT_PUBLIC_API_MODE=real

# Адрес используется только в режиме real.
NUXT_PUBLIC_API_BASE=http://localhost:16768

# Секретный ключ для подписи csrf. Его не стоит генерить автоматически, так как Когда сервер генерирует ключ сам «на лету» в памяти, этот ключ живет ровно до тех пор, пока работает процесс Node.js. 
# Вы обновили код на сервере или сервер перезагрузился после ошибки. Ключ в памяти стерся и сгенерировался новый. Все текущие пользователи, которые прямо сейчас сидят на сайте, получат ошибку 403 Forbidden при следующей отправке любой формы, потому что их старые токены (подписанные старым ключом) больше не валидны. Им придется обновлять страницу.
# Если ваш сайт станет популярным и вы запустите его, например, на 3-х параллельных процессах (через PM2) или на 2-х серверах за Load Balancer, каждый процесс сгенерирует свой собственный случайный ключ. Пользователь заходит на сайт -> запрос попадает на Сервер №1 (выдан токен А). Пользователь жмет «Отправить» -> запрос балансируется на Сервер №2. Сервер №2 сверяет токен своим ключом, выдает ошибку, и форма не отправляется.
NUXT_CSRF_SECRET="REPLACE_THIS_TEXT!!!!!!!!!!!!!32"